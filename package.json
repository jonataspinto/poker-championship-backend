{
  "name": "poker-championship-backend",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "license": "MIT",
  "scripts": {
    "server": "ts-node-dev --respawn --transpile-only  -r tsconfig-paths/register src/index.ts",
    "build": "sucrase ./src -d ./dist --transforms typescript,imports",
    "start": "node ./dist/index.js",
    "test": "jest --colors",
    "test:coverage": "jest --colors --coverage",
    "test:watch": "jest --verbose --colors --watch",
    "check:types": "tsc --pretty --noEmit",
    "check:all": "npm run check:types",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.2.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.25.2",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "sucrase": "^3.35.0",
    "ts-jest": "^29.3.2",
    "ts-node-dev": "^1.1.8"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^5.1.0",
    "firebase-admin": "^9.12.0",
    "module-alias": "^2.2.3",
    "nodemailer": "^6.10.1",
    "typescript": "^5.0.4",
    "uuid": "^8.3.2"
  }
}
