# replace the {project_id} with your actual Firebase project ID
# and fill in the other fields with your Firebase service account details.

FIREBASE_PROJECT_ID={project_id}
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-qvzwe@{project_id}.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=""
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-qvzwe%40{project_id}.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
FIREBASE_DATABASE_URL=https://{project_id}.firebaseio.com
FIREBASE_STORAGE_BUCKET={project_id}.appspot.com
