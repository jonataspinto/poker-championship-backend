{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "types/*"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
